# Optional. A GitHub personal access token with no scopes (public data only).
# Without it RepoInsight uses the unauthenticated GitHub API (60 requests/hour per IP).
# With it the limit is 5,000 requests/hour. The token never leaves the server.
GITHUB_TOKEN=

# Optional. Canonical site URL, used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=
